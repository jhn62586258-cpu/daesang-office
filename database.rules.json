{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$sid": {
        ".write": "auth != null && $sid.beginsWith(auth.uid)",
        ".validate": "newData.hasChildren(['n', 'x', 'z']) && newData.child('n').isString() && newData.child('n').val().length <= 10"
      }
    },
    "chat": {
      ".read": "auth != null",
      ".write": "auth != null && !newData.exists()",
      ".indexOn": [
        "at"
      ],
      "$msgId": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 80 && newData.child('at').isNumber()"
      }
    },
    "group_chats": {
      "$roomId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || (!data.exists() && newData.child('members').child(auth.uid).exists()))",
        "meta": {
          ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 20"
        },
        "messages": {
          ".indexOn": [
            "at"
          ],
          "$msgId": {
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('at').isNumber()"
          }
        }
      }
    },
    "user_rooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$roomId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('group_chats').child($roomId).child('members').child(auth.uid).exists())",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "board_notes": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$noteId": {
        ".write": "auth != null",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 60 && newData.child('at').isNumber()"
      }
    },
    "desk_notes": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$noteId": {
        ".write": "auth != null",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 80 && newData.child('seat').isString() && newData.child('at').isNumber()"
      }
    },
    "desk_notes_archive": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$noteId": {
        ".write": "auth != null",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 80 && newData.child('seat').isString() && newData.child('at').isNumber()"
      }
    },
    "snack_options": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$optId": {
        ".write": "auth != null",
        ".validate": "newData.child('label').isString() && newData.child('label').val().length >= 1 && newData.child('label').val().length <= 20"
      }
    },
    "snack_votes": {
      ".read": "auth != null",
      "$week": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('choice').isString() && newData.child('choice').val().length <= 40"
        }
      }
    },
    "custom_restaurants": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$restId": {
        ".write": "auth != null",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30"
      }
    },
    "archi_stories": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$storyId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('authorId').val() === auth.uid))",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 300 && newData.child('title').isString() && newData.child('title').val().length <= 40 && newData.child('url').isString() && newData.child('url').val().length <= 300 && (newData.child('url').val() === '' || newData.child('url').val().matches(/^https?:\\/\\//)) && newData.child('at').isNumber()"
      }
    },
    "tree_wishes": {
      ".read": "auth != null",
      ".indexOn": [
        "at"
      ],
      "$wishId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('authorId').val() === auth.uid))",
        ".validate": "newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 100 && newData.child('at').isNumber()"
      }
    },
    "project_dday": {
      ".read": "auth != null",
      "$projectId": {
        ".write": "auth != null",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40 && newData.child('date').isString() && newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      }
    },
    "archi_models": {
      ".read": "auth != null",
      "$modelId": {
        ".write": "auth != null",
        ".validate": "newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 40 && newData.child('desc').isString() && newData.child('desc').val().length <= 300 && newData.child('url').isString() && newData.child('url').val().length <= 300 && (newData.child('url').val() === '' || newData.child('url').val().matches(/^https?:\\/\\//))"
      }
    }
  }
}